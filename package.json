{
  "name": "mabriona-browser",
  "productName": "MABRIONA Browser",
  "version": "1.4.1",
  "description": "El navegador web propio de MABRIONA Corporation — motor Chromium real (Electron), pestañas, perfiles, extensiones de Chrome, importación de datos de otros navegadores, historial, favoritos, descargas, privacidad, MABRIONA SHIELDS y MABRIONA Search.",
  "main": "main.js",
  "author": "MABRIONA Corporation <soporte@mabriona.com>",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/address-resolver.test.js test/blocklist.test.js test/braveSearch.test.js test/browserImport.test.js test/deeplTranslate.test.js test/djiaBridge.test.js test/extensions.test.js test/permissions.test.js test/profiles.test.js test/settings.test.js test/spectrumResolver.test.js test/store.test.js test/tools.test.js",
    "dist": "electron-builder --mac zip dir",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis --publish=never"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "qrcode": "^1.5.4",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "playwright": "^1.61.1"
  },
  "build": {
    "appId": "com.mabriona.browser",
    "productName": "MABRIONA Browser",
    "icon": "build/icon.icns",
    "files": [
      "main.js",
      "preload.js",
      "search-preload.js",
      "store.js",
      "profiles.js",
      "extensions.js",
      "browserImport.js",
      "address-resolver.js",
      "brave-api-key.local.json",
      "deepl-api-key.local.json",
      "renderer/**/*",
      "shields/**/*",
      "search/**/*",
      "bridge/**/*",
      "translate/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network"
    },
    "win": {
      "icon": "build/icon-windows-source.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
