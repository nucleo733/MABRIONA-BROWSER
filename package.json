{
  "name": "mabriona-browser",
  "productName": "MABRIONA Browser",
  "version": "1.0.0",
  "description": "El navegador web propio de MABRIONA Corporation — motor Chromium real (Electron), pestañas, perfiles, historial, favoritos, descargas, privacidad, MABRIONA SHIELDS y MABRIONA Search.",
  "main": "main.js",
  "author": "MABRIONA Corporation <soporte@mabriona.com>",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "dist": "electron-builder --mac zip dir",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "playwright": "^1.61.1"
  },
  "build": {
    "appId": "com.mabriona.browser",
    "productName": "MABRIONA Browser",
    "icon": "build/icon.icns",
    "files": [
      "main.js",
      "preload.js",
      "search-preload.js",
      "store.js",
      "profiles.js",
      "address-resolver.js",
      "brave-api-key.local.json",
      "renderer/**/*",
      "shields/**/*",
      "search/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "dir",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "category": "Network"
    }
  }
}
